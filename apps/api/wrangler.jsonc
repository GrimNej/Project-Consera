{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "consera",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "consera.grimnej.com",
      "custom_domain": true,
    },
  ],
  "secrets": {
    "required": [
      "ACCESS_PASSCODE",
      "APP_ORIGIN",
      "GITHUB_DISPATCH_TOKEN",
      "SESSION_SIGNING_SECRET",
      "SNOWFLAKE_ACCOUNT_LOCATOR",
      "SNOWFLAKE_HOST",
      "SNOWFLAKE_PRIVATE_KEY",
      "SNOWFLAKE_PUBLIC_KEY_FINGERPRINT",
      "SNOWFLAKE_USER",
    ],
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/out",
    "run_worker_first": [
      "/",
      "/index.html",
      "/console",
      "/console/",
      "/console.html",
      "/access",
      "/access/",
      "/access.html",
      "/api/*",
    ],
  },
  "ratelimits": [
    {
      "name": "AUTH_CLIENT_RATE_LIMITER",
      "namespace_id": "340921",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
    {
      "name": "AUTH_GLOBAL_RATE_LIMITER",
      "namespace_id": "340922",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
    },
  },
}
