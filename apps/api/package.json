{
  "name": "@consera/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir worker-dist",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "cf-typegen:check": "wrangler types --env-interface CloudflareBindings --check",
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@consera/contracts": "workspace:*",
    "hono": "4.12.31",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@consera/fixture-data": "workspace:*",
    "@types/node": "26.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  }
}
